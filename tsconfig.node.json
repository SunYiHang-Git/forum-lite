{
  "extends": "@tsconfig/node18/tsconfig.json",
  "include": ["*.js", "*.ts", "internal"],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "types": ["node"]
  }
}
